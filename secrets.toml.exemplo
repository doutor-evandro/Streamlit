# MODELO — copie para  .streamlit/secrets.toml  e edite.
#
# O arquivo real NUNCA vai para o GitHub: esta no .gitignore.
# No Streamlit Cloud, cole este conteudo em:
#     Manage app  ->  menu ⋮  ->  Settings  ->  Secrets

# ---------------------------------------------------------------
# Banco de dados — Supabase (Projeto 03)
#
# Pegue a string no painel do Supabase: botao "Connect" no topo.
# ESCOLHA "Session pooler". A conexao direta so responde em IPv6 e
# o servidor do Streamlit Cloud e IPv4 — daria erro la, mesmo
# funcionando no seu PC.
#
# Formato do Session pooler:
#   postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------
[connections.supabase]
url = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Senha da area restrita (Projetos 09 e 10)
# ---------------------------------------------------------------
[app]
senha = "troque-esta-senha"

# ---------------------------------------------------------------
# Espaco para o que vier depois
