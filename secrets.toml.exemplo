# MODELO — copie este arquivo para  .streamlit/secrets.toml  e edite.
#
# O arquivo real NUNCA vai para o GitHub: ele esta no .gitignore.
# No Streamlit Cloud, cole este mesmo conteudo em:
#     Manage app  ->  menu ⋮  ->  Settings  ->  Secrets
#
# Usado pelos Projetos 09 e 10.

[app]
senha = "troque-esta-senha"

